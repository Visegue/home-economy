{
  "name": "home-economy",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:version": "node scripts/check-app-version.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:e2e": "node scripts/run-playwright.mjs test",
    "auth:schema": "auth generate --adapter drizzle --dialect postgresql --config src/lib/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:studio": "drizzle-kit studio",
    "check": "pnpm check:version && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@electric-sql/pglite": "0.5.8",
    "@next/env": "16.3.5",
    "@vercel/functions": "^3.9.7",
    "better-auth": "1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "postgres": "3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "auth": "1.7.4",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.0.1",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}
