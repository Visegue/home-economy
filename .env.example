# Lokal utveckling använder PGlite när DATABASE_URL saknas.
PGLITE_DATA_DIR=.data/pglite

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ALLOWED_EMAILS=

# Neon: använd den poolade anslutningssträngen för applikationen.
# DATABASE_URL=postgresql://...
# DATABASE_MIGRATION_URL=postgresql://...
DATABASE_POOL_SIZE=5
