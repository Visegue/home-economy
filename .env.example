# Lokal utveckling: egen Neon-branch, skild från Preview.
DATABASE_PROVIDER=postgres
# Poolad home_economy_runtime-anslutning till din utvecklingsbranch.
DATABASE_URL=
# Direkt ägaranslutning till samma branch, endast för migrationer.
DATABASE_MIGRATION_URL=
# Offline: välj DATABASE_PROVIDER=pglite (endast lokalt/test).
PGLITE_DATA_DIR=.data/pglite

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel-previews använder produktionens Google OAuth-callback.
# Lämna tomma lokalt; sätt samma OAUTH_PROXY_SECRET i Preview och Production.
OAUTH_PROXY_PRODUCTION_URL=
OAUTH_PROXY_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=

# Verifierings- och återställningsmejl via Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Hemekonomi <auth@your-domain.example>

DATABASE_POOL_SIZE=5
